# Keep this file private; never commit real credentials.
# Generate both: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
API_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
DUFFEL_ACCESS_TOKEN=duffel_test_YOUR_TEST_TOKEN
# Optional: Seats.aero Partner API key; subject to plan restrictions and licensing.
SEATS_AERO_API_KEY=
HOST=127.0.0.1
PORT=3434
DATA_FILE=./data/private.enc.json
WATCH_POLL_MINUTES=30
# Enable only after activating Duffel and funding your balance, and inspecting all terms.
ENABLE_LIVE_BOOKING=false

# Hosted-only secrets: set these in Vercel, never commit actual values.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN
REDIS_STATE_KEY=fluttershy:state:v1
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ALLOW_HOSTED_BOOKING=false
